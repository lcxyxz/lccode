    "url": "https://github.com/lcxyxz/lccode.git"
  },
  "bugs": {
    "url": "https://github.com/lcxyxz/lccode/issues"
  },
  "homepage": "https://github.com/lcxyxz/lccode#readme",
  "author": "lcxyxz",
  "license": "MIT",
  "engines": {
    "bun": ">=1.2.14"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/bun": "^1.3.0",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "cli-highlight": "^2.1.11",
    "diff": "^9.0.0",
    "ink": "^7.1.0",
    "ink-text-input": "^6.0.0",
    "marked": "9.0.3",
