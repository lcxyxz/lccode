{
  "name": "@lcxyxz/lccode",
  "version": "0.1.3",
  "description": "一款由桂电找不到工作的学生郁郁寡欢的情况下开发的一个agent助手",
  "bin": {
    "lccode": "./dist/bin/lccode.js"
  },
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "bun src/cli.tsx",
    "build": "bun scripts/build.ts",
    "build:all": "bun scripts/build.ts --all",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build:all"
